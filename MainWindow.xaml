<Window x:Class="ConsolaShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consola"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#05070B"
        Cursor="None"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#16243A" Offset="0" />
                <GradientStop Color="#05070B" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Barra superior: estado del mando y hora -->
        <TextBlock x:Name="IndicadorMando"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="60,44,0,0" FontSize="18" Foreground="#7F8DA3"
                   Text="Buscando mando…" />
        <TextBlock x:Name="Reloj"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,36,60,0" FontSize="30" Foreground="#B8C4D6" />

        <!-- Pantalla de carga -->
        <StackPanel x:Name="PanelCarga" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TextoPerfil"
                       Text="CONSOLA" FontSize="64" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center" />

            <Grid Width="72" Height="72" Margin="0,48,0,0">
                <Ellipse Stroke="#22FFFFFF" StrokeThickness="5" />
                <Path Stroke="#4FC3F7" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5"
                      Data="M 36,2.5 A 33.5,33.5 0 0 1 69.5,36">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="Giro" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <TextBlock x:Name="TextoEstado"
                       Text="Iniciando…" FontSize="24" Foreground="#B8C4D6"
                       Margin="0,32,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Centro de control: menú + estado del PC + mandos.
             Viewbox DownOnly: en pantallas pequeñas se reduce, en 1080p/4K queda a tamaño real. -->
        <Viewbox x:Name="PanelMenu" Visibility="Collapsed" StretchDirection="DownOnly" Margin="40,100,40,90">
            <StackPanel Orientation="Horizontal">
                <Border MinWidth="440" Padding="36,28" CornerRadius="16" VerticalAlignment="Top"
                        Background="#E60B111B" BorderBrush="#334FC3F7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="TituloMenu" Text="Centro de control" FontSize="32" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock x:Name="DetalleMenu" FontSize="18" Foreground="#FF8A80"
                                   TextWrapping="Wrap" MaxWidth="440" Margin="0,0,0,16" Visibility="Collapsed" />
                        <StackPanel x:Name="ListaMenu" Margin="0,8,0,0" />
                        <TextBlock Text="Ⓐ Seleccionar     ◀ ▶ Ajustar     Ⓑ Volver" FontSize="16" Foreground="#7F8DA3" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="28,0,0,0" Padding="22,24" CornerRadius="16" VerticalAlignment="Top"
                        Background="#E60B111B" BorderBrush="#334FC3F7" BorderThickness="1">
                    <StackPanel Width="616">
                        <TextBlock Text="Estado del PC" FontSize="24" Foreground="White" Margin="6,0,0,2" />
                        <TextBlock x:Name="TextoHardware" FontSize="15" Foreground="#7F8DA3" Margin="6,0,0,10"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel x:Name="PanelGraficas" />
                        <TextBlock x:Name="TextoMemoria" FontSize="17" Foreground="#B8C4D6" Margin="6,10,0,0" />

                        <TextBlock Text="Qué usa la RAM" FontSize="24" Foreground="White" Margin="6,26,0,8" />
                        <StackPanel x:Name="PanelProcesos" Margin="6,0,6,0" />

                        <TextBlock Text="Mandos" FontSize="24" Foreground="White" Margin="6,26,0,10" />
                        <StackPanel x:Name="PanelMandos" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Viewbox>

        <!-- Ayuda inferior -->
        <TextBlock x:Name="Ayuda"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,48" FontSize="16" Foreground="#5E6B80"
                   Text="Mantén ⧉ Vista + ☰ Menú para ver opciones" />
    </Grid>
</Window>
