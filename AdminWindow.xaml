<Window x:Class="ConsolaShell.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsolaShell · Administración"
        Width="1120" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B111B" Foreground="#E6EDF5"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15">

    <Window.Resources>
        <SolidColorBrush x:Key="Tenue" Color="#7F8DA3" />
        <SolidColorBrush x:Key="Acento" Color="#4FC3F7" />

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="#121A27" />
            <Setter Property="BorderBrush" Value="#24324A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="TituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Tenue}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6EDF5" />
            <Setter Property="Background" Value="#1B2638" />
            <Setter Property="BorderBrush" Value="#2C3B55" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Principal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4FC3F7" />
            <Setter Property="BorderBrush" Value="#4FC3F7" />
            <Setter Property="Foreground" Value="#05070B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Peligro" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#7A2E2E" />
            <Setter Property="Foreground" Value="#FF8A80" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B111B" />
            <Setter Property="Foreground" Value="#E6EDF5" />
            <Setter Property="BorderBrush" Value="#2C3B55" />
            <Setter Property="CaretBrush" Value="#E6EDF5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="ConsolaShell" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="TextoSesion" Foreground="{StaticResource Tenue}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Contenido">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda: estado y acciones -->
                <StackPanel>
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Estado" Style="{StaticResource TituloTarjeta}" />
                            <StackPanel x:Name="ListaEstado" />
                            <Border Background="#1A2B3F" CornerRadius="10" Padding="14,10" Margin="0,12,0,12">
                                <TextBlock x:Name="SiguientePaso" TextWrapping="Wrap" Foreground="{StaticResource Acento}" />
                            </Border>
                            <Button x:Name="BtnActualizar" Content="Actualizar estado" HorizontalAlignment="Left" Click="AlActualizar" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Acciones" Style="{StaticResource TituloTarjeta}" />
                            <WrapPanel>
                                <Button x:Name="BtnInstalar" Content="Instalar / actualizar" Style="{StaticResource Principal}" Click="AlInstalar" />
                                <Button x:Name="BtnActivar" Content="Activar modo consola" Click="AlActivar" />
                                <Button x:Name="BtnProbar" Content="Probar modo consola aquí" Click="AlProbar" />
                                <Button x:Name="BtnReiniciar" Content="Reiniciar PC" Click="AlReiniciar" />
                            </WrapPanel>
                            <TextBlock x:Name="NotaInstalar" TextWrapping="Wrap" Foreground="{StaticResource Tenue}" FontSize="13" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Tarjeta}" BorderBrush="#4A2A2A">
                        <StackPanel>
                            <TextBlock Text="Desinstalar" Style="{StaticResource TituloTarjeta}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Tenue}" FontSize="13" Margin="0,0,0,12"
                                       Text="Solo afecta al perfil de consola: tu cuenta y las demás no se tocan." />
                            <WrapPanel>
                                <Button x:Name="BtnRevertir" Content="Desactivar modo consola" Style="{StaticResource Peligro}" Click="AlRevertir" />
                                <Button x:Name="BtnEliminar" Content="Eliminar perfil…" Style="{StaticResource Peligro}" Click="AlEliminar" />
                            </WrapPanel>
                            <CheckBox x:Name="ChkBorrarArchivos" Content="Al eliminar, borrar también C:\ConsolaShell" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Columna derecha: perfil y configuración -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Perfil de consola" Style="{StaticResource TituloTarjeta}" />
                            <TextBlock Text="Nombre de usuario de Windows" Style="{StaticResource Etiqueta}" />
                            <DockPanel>
                                <Button x:Name="BtnRenombrar" DockPanel.Dock="Right" Content="Renombrar" Margin="10,0,0,8" Click="AlRenombrar" />
                                <TextBox x:Name="TxtUsuario" MaxLength="20" />
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Tenue}" FontSize="13"
                                       Text="Cambia la cuenta, el inicio automático y el nombre de la pantalla de carga. La carpeta en C:\Users mantiene el nombre anterior (Windows no la renombra)." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Configuración" Style="{StaticResource TituloTarjeta}" />
                            <TextBlock x:Name="TextoRutaConfig" Foreground="{StaticResource Tenue}" FontSize="13" Margin="0,-6,0,12" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Nombre en pantalla" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="TxtNombrePerfil" Grid.Column="1" MaxLength="30" />

                                <TextBlock Grid.Row="1" Text="Ruta de steam.exe" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="TxtRutaSteam" Grid.Row="1" Grid.Column="1" ToolTip="Vacío = detectar automáticamente" />

                                <TextBlock Grid.Row="2" Text="Espera máxima de carga (s)" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="TxtTiempoCarga" Grid.Row="2" Grid.Column="1" />

                                <TextBlock Grid.Row="3" Text="Mantener Vista + Menú (s)" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="TxtSegundosMenu" Grid.Row="3" Grid.Column="1" />

                                <TextBlock Grid.Row="4" Text="Panel al salir de Big Picture (s)" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="TxtSegundosPanel" Grid.Row="4" Grid.Column="1" />
                            </Grid>
                            <Button x:Name="BtnGuardar" Content="Guardar configuración" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AlGuardar" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Registro de lo que hacen los scripts -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,4,0,0" Padding="14,10">
            <TextBox x:Name="Registro" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#B8C4D6"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
